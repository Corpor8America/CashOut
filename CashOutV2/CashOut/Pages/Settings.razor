@page "/settings"
@inject HttpClient Http
@using System.Net.Http.Json

<MudText Typo="Typo.h4" GutterBottom="true">Settings</MudText>

@if (_error != null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="my-4">@_error</MudAlert>
}

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-7" />
}
else
{
    <MudPaper Elevation="1" Class="pa-6" MaxWidth="600px">
        <MudSimpleTable Elevation="0">
            <tbody>
                <tr>
                    <td><strong>Version</strong></td>
                    <td><MudText Typo="Typo.body2" Style="font-family:monospace">@_version</MudText></td>
                </tr>
            </tbody>
        </MudSimpleTable>
    </MudPaper>

    <MudPaper Elevation="1" Class="pa-6 mt-6" MaxWidth="600px">
        <MudText Typo="Typo.h6" GutterBottom="true">Data Cleanup</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            Find and remove transactions and CSV mapping profiles that reference
            deleted accounts.
        </MudText>

        @if (!_cleanupConfirming)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Warning"
                       OnClick="@StartCleanup" Disabled="@_cleaning"
                       StartIcon="@Icons.Material.Filled.CleaningServices">
                @(_cleaning ? "Cleaning..." : "Find & Remove Orphans")
            </MudButton>
        }
        else
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Class="mb-4">
                This will permanently delete orphaned data. Are you sure?
            </MudAlert>
            <MudStack Row="true" Spacing="2">
                <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="@ConfirmCleanup">Yes, clean up</MudButton>
                <MudButton Variant="Variant.Outlined" OnClick="@CancelCleanup">Cancel</MudButton>
            </MudStack>
        }

        @if (_cleaning)
        {
            <MudProgressLinear Color="Color.Warning" Indeterminate="true" Class="my-4" />
        }

        @if (_cleanupResult != null)
        {
            <MudAlert Severity="@(_cleanupResult.TransactionsRemoved > 0 || _cleanupResult.ProfilesRemoved > 0 ? Severity.Success : Severity.Info)"
                      Variant="Variant.Outlined" Class="mt-4" Dense="true">
                Removed @_cleanupResult.TransactionsRemoved transaction(s) and @_cleanupResult.ProfilesRemoved CSV mapping profile(s).
            </MudAlert>
        }
    </MudPaper>
}

@code {
    private string _version = "—";
    private bool _loading = true;
    private string? _error;

    private bool _cleaning;
    private bool _cleanupConfirming;
    private CleanupResult? _cleanupResult;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var versionResp = await Http.GetFromJsonAsync<Dictionary<string, string>>("api/version");
            if (versionResp?.TryGetValue("version", out var v) == true) _version = v;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private void StartCleanup() { _cleanupResult = null; _error = null; _cleanupConfirming = true; }
    private void CancelCleanup() { _cleanupConfirming = false; }

    private async Task ConfirmCleanup()
    {
        _cleanupConfirming = false; _cleaning = true; _cleanupResult = null; _error = null;
        try
        {
            var resp = await Http.PostAsync("api/settings/cleanup", null);
            resp.EnsureSuccessStatusCode();
            _cleanupResult = await resp.Content.ReadFromJsonAsync<CleanupResult>();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _cleaning = false; }
    }

    private record CleanupResult(int TransactionsRemoved, int ProfilesRemoved);
}
