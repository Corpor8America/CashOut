@page "/reports/cashflow"
@inject HttpClient Http

<ReportShell Title="Inflow vs Outflow"
             ShowMonthRange="true"
             RangeYears="_rangeYears"
             FromMonth="_fromMonth"
             OnFromMonthChanged="OnFromMonthChanged"
             FromYear="_fromYear"
             OnFromYearChanged="OnFromYearChanged"
             ToMonth="_toMonth"
             OnToMonthChanged="OnToMonthChanged"
             ToYear="_toYear"
             OnToYearChanged="OnToYearChanged"
             Accounts="_accounts"
             AccountId="_accountId"
             OnAccountIdChanged="OnAccountIdChanged"
             Loading="_loading"
             Error="@_error"
             ExportHref="@BuildExportHref()">
    @if (_report is null)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
            No cash flow data found.
        </MudAlert>
    }
    else
    {
        <div class="report-summary-grid">
            <div class="metric-panel">
                <div class="metric-label">Total Income</div>
                <div class="metric-value income-value">@_report.TotalIncome.ToString("C")</div>
                <div class="metric-sub income-value">Avg/mo: @AvgIncome.ToString("C")</div>
            </div>
            <div class="metric-panel">
                <div class="metric-label">Total Expenses</div>
                <div class="metric-value expense-value">@_report.TotalExpenses.ToString("C")</div>
                <div class="metric-sub expense-value">Avg/mo: @AvgExpenses.ToString("C")</div>
            </div>
            <div class="metric-panel">
                <div class="metric-label">Total Net</div>
                <div class="metric-value @NetClass(_report.NetCashFlow)">@_report.NetCashFlow.ToString("C")</div>
                <div class="metric-sub @NetClass(AvgNet)">Avg/mo: @AvgNet.ToString("C")</div>
            </div>
        </div>

        <MudTable T="CashFlowMonthRow"
                  Items="@_report.Months"
                  Dense="true"
                  Hover="true"
                  Breakpoint="Breakpoint.Sm"
                  Elevation="0"
                  OnRowClick="OnMonthRowClick"
                  RowClassFunc="GetRowClass"
                  Class="mt-4">
            <ColGroup>
                <col style="width: 25%" />
                <col style="width: 25%" />
                <col style="width: 25%" />
                <col style="width: 25%" />
            </ColGroup>
            <HeaderContent>
                <MudTh>Month</MudTh>
                <MudTh Class="right-align">Income</MudTh>
                <MudTh Class="right-align">Expenses</MudTh>
                <MudTh Class="right-align">Net</MudTh>
            </HeaderContent>
            <RowTemplate Context="month">
                <MudTd DataLabel="Month">@month.Label</MudTd>
                <MudTd DataLabel="Income" Class="right-align income-value">@month.Income.ToString("C")</MudTd>
                <MudTd DataLabel="Expenses" Class="right-align expense-value">@month.Expenses.ToString("C")</MudTd>
                <MudTd DataLabel="Net" Class="right-align" Style="@(month.Net > 0 ? "color:#1b5e20 !important;font-weight:600 !important" : month.Net < 0 ? "color:#b71c1c !important;font-weight:600 !important" : "")">@month.Net.ToString("C")</MudTd>
            </RowTemplate>
        </MudTable>

        @if (_selectedMonth is not null)
        {
            <div class="drilldown-header mt-4">
                <span class="drilldown-title">@_selectedMonth.Label</span>
                <span class="drilldown-meta">
                    Income: @_selectedMonth.Income.ToString("C") —
                    Expenses: @_selectedMonth.Expenses.ToString("C") —
                    Net: @_selectedMonth.Net.ToString("C") —
                    @_selectedMonth.TransactionCount.ToString("N0") transactions
                </span>
            </div>

            @if (_selectedMonth.Transactions.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="mt-2">No transactions for this month.</MudText>
            }
            else
            {
                <MudTable Items="@_selectedMonth.Transactions"
                          Dense="true"
                          Hover="true"
                          Breakpoint="Breakpoint.Sm"
                          Elevation="0"
                          Class="mt-2">
                    <HeaderContent>
                        <MudTh>Date</MudTh>
                        <MudTh>Name</MudTh>
                        <MudTh>Category</MudTh>
                        <MudTh>Account</MudTh>
                        <MudTh Class="right-align">Amount</MudTh>
                    </HeaderContent>
                    <RowTemplate Context="txn">
                        <MudTd DataLabel="Date">@txn.Date.ToString("MMM dd, yyyy")</MudTd>
                        <MudTd DataLabel="Name">@txn.Name</MudTd>
                        <MudTd DataLabel="Category">@txn.Category</MudTd>
                        <MudTd DataLabel="Account">@txn.AccountName</MudTd>
                        <MudTd DataLabel="Amount" Class="right-align" Style="@(txn.Amount >= 0 ? "color:#1b5e20 !important;font-weight:600 !important" : "color:#b71c1c !important;font-weight:600 !important")">@txn.Amount.ToString("C")</MudTd>
                    </RowTemplate>
                </MudTable>
            }
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mt-4">Select a month to view transactions.</MudText>
        }
    }
</ReportShell>

<style>
    .report-summary-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 16px; }
    .metric-panel { padding: 12px 16px; border: 1px solid var(--mud-palette-lines-inputs, #e0e0e0); border-radius: 8px; }
    .metric-label { font-size: 0.8rem; color: var(--mud-palette-text-secondary, #757575); margin-bottom: 4px; }
    .metric-value { font-size: 1.5rem; font-weight: 600; }
    .metric-sub { font-size: 0.85rem; margin-top: 2px; }
    .right-align { text-align: right; }
    .income-value { color: #1b5e20; }
    .expense-value { color: #b71c1c; }
    .net-positive { color: #1b5e20; font-weight: 600; }
    .net-negative { color: #b71c1c; font-weight: 600; }
    .amount-positive { color: #1b5e20; font-weight: 600; }
    .amount-negative { color: #b71c1c; font-weight: 600; }
    .drilldown-header { padding: 12px 0 4px 0; border-bottom: 1px solid var(--mud-palette-lines-inputs, #e0e0e0); }
    .drilldown-title { font-size: 1rem; font-weight: 600; margin-right: 12px; }
    .drilldown-meta { font-size: 0.85rem; color: var(--mud-palette-text-secondary, #757575); }
    ::deep .mud-table-root .right-align { text-align: right; }
    ::deep .mud-table-root .mud-table-body .mud-table-cell.net-positive { color: #1b5e20 !important; font-weight: 600; }
    ::deep .mud-table-root .mud-table-body .mud-table-cell.net-negative { color: #b71c1c !important; font-weight: 600; }
    ::deep .mud-table-root .mud-table-body .mud-table-cell.amount-positive { color: #1b5e20 !important; font-weight: 600; }
    ::deep .mud-table-root .mud-table-body .mud-table-cell.amount-negative { color: #b71c1c !important; font-weight: 600; }
    ::deep .selected-row { background-color: rgba(46, 125, 50, 0.08); }
    ::deep .selected-row:hover { background-color: rgba(46, 125, 50, 0.12); }
</style>

@code {
    private bool _loading;
    private string? _error;
    private CashFlowReportResult? _report;
    private CashFlowMonthRow? _selectedMonth;

    private int _fromMonth = 1;
    private int _fromYear = DateTime.Now.Year;
    private int _toMonth = DateTime.Now.Month;
    private int _toYear = DateTime.Now.Year;
    private string? _accountId;
    private List<int> _rangeYears = new();
    private List<ReportShell.AccountOption> _accounts = new();

    private decimal AvgIncome => _report?.Months.Count > 0
        ? Math.Round(_report.TotalIncome / _report.Months.Count, 2) : 0m;
    private decimal AvgExpenses => _report?.Months.Count > 0
        ? Math.Round(_report.TotalExpenses / _report.Months.Count, 2) : 0m;
    private decimal AvgNet => _report?.Months.Count > 0
        ? Math.Round(_report.NetCashFlow / _report.Months.Count, 2) : 0m;

    protected override async Task OnInitializedAsync()
    {
        await LoadYears();
        await LoadAccounts();
        await LoadReport();
    }

    private async Task LoadYears()
    {
        try
        {
            var years = await Http.GetFromJsonAsync<List<int>>("api/settings/years");
            if (years is { Count: > 0 })
            {
                _rangeYears = years;
                _fromYear = years[0];
                _toYear = years[0];
            }
        }
        catch { _rangeYears = new() { DateTime.Now.Year }; }
    }

    private async Task LoadAccounts()
    {
        try
        {
            var result = await Http.GetFromJsonAsync<List<AccountDto>>("api/accounts");
            if (result is not null)
                _accounts = result.Select(a => new ReportShell.AccountOption(a.Id, a.Name)).ToList();
        }
        catch { _accounts = new(); }
    }

    private async Task OnFromMonthChanged(int? month)
    {
        _fromMonth = month ?? 1;
        _selectedMonth = null;
        await LoadReport();
    }

    private async Task OnFromYearChanged(int? year)
    {
        _fromYear = year ?? DateTime.Now.Year;
        _selectedMonth = null;
        await LoadReport();
    }

    private async Task OnToMonthChanged(int? month)
    {
        _toMonth = month ?? 12;
        _selectedMonth = null;
        await LoadReport();
    }

    private async Task OnToYearChanged(int? year)
    {
        _toYear = year ?? DateTime.Now.Year;
        _selectedMonth = null;
        await LoadReport();
    }

    private async Task OnAccountIdChanged(string? accountId)
    {
        _accountId = accountId;
        _selectedMonth = null;
        await LoadReport();
    }

    private async Task LoadReport()
    {
        _loading = true; _error = null;
        try
        {
            var url = BuildApiUrl();
            _report = await Http.GetFromJsonAsync<CashFlowReportResult>(url);
            _selectedMonth = null;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private string BuildApiUrl()
    {
        var parts = new List<string>();
        if (!string.IsNullOrEmpty(_accountId))
            parts.Add($"accountId={Uri.EscapeDataString(_accountId)}");
        parts.Add($"fromYear={_fromYear}");
        parts.Add($"fromMonth={_fromMonth}");
        parts.Add($"toYear={_toYear}");
        parts.Add($"toMonth={_toMonth}");
        return $"api/reports/cashflow?{string.Join("&", parts)}";
    }

    private string BuildExportHref()
    {
        var parts = new List<string> { "format=csv" };
        if (!string.IsNullOrEmpty(_accountId))
            parts.Add($"accountId={Uri.EscapeDataString(_accountId)}");
        parts.Add($"fromYear={_fromYear}");
        parts.Add($"fromMonth={_fromMonth}");
        parts.Add($"toYear={_toYear}");
        parts.Add($"toMonth={_toMonth}");
        return $"api/reports/cashflow?{string.Join("&", parts)}";
    }

    private void OnMonthRowClick(TableRowClickEventArgs<CashFlowMonthRow> args) => _selectedMonth = args.Item;
    private string GetRowClass(CashFlowMonthRow row, int index) => row == _selectedMonth ? "selected-row" : "";
    private string NetClass(decimal value) => value > 0 ? "net-positive" : value < 0 ? "net-negative" : "";
    private string NetAlignClass(decimal value) => $"right-align {NetClass(value)}";

    private record AccountDto(string Id, string Name);
    private record CashFlowReportResult(int Year, int PreviousYear, decimal TotalIncome, decimal TotalExpenses, decimal NetCashFlow, decimal PreviousYearNet, decimal NetChangeAmount, decimal NetChangePercent, decimal AverageMonthlyNet, decimal BestMonthNet, string BestMonthLabel, decimal WorstMonthNet, string WorstMonthLabel, int TransactionCount, List<CashFlowMonthRow> Months);
    private record CashFlowMonthRow(string Month, string Label, decimal Income, decimal Expenses, decimal Net, decimal RollingAverageNet, decimal PreviousYearNet, decimal ChangeAmount, decimal ChangePercent, int IncomeCount, int ExpenseCount, int TransactionCount, List<CashFlowTransactionRow> Transactions);
    private record CashFlowTransactionRow(string TransactionId, string AccountId, string AccountName, DateOnly Date, string Name, string RawName, decimal Amount, decimal? Debit, decimal? Credit, string Category, TransactionSource Source);
}
