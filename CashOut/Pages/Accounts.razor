@page "/accounts"
@inject HttpClient Http

<MudText Typo="Typo.h4" GutterBottom="true">Accounts</MudText>

<MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
           OnClick="ShowCreateForm" Class="mb-4">
    Create Account
</MudButton>

@if (_showForm)
{
    <MudPaper Elevation="1" Class="pa-4 mb-4" MaxWidth="400px">
        <MudTextField T="string" @bind-Value="_newName" Label="Account Name" Required="true" />
        <MudTextField T="string" @bind-Value="_newDescription" Label="Description (optional)" />
        <MudStack Row="true" Spacing="2" Class="mt-2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateAccount">Save</MudButton>
            <MudButton Variant="Variant.Outlined" OnClick="CancelCreate">Cancel</MudButton>
        </MudStack>
    </MudPaper>
}

@if (!string.IsNullOrEmpty(_message))
{
    <MudAlert Severity="Severity.Success" Variant="Variant.Filled" Class="my-2">@_message</MudAlert>
}
@if (!string.IsNullOrEmpty(_error))
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="my-2">@_error</MudAlert>
}

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-7" />
}
else if (_accounts.Count == 0)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
        No accounts yet. Create one to import CSV transactions.
    </MudAlert>
}
else
{
    <MudTable Items="@_accounts" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="1" Dense="true">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Description</MudTh>
            <MudTh>Created</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">
                <MudLink Href="@($"/transactions?accountId={context.Id}")">@context.Name</MudLink>
            </MudTd>
            <MudTd DataLabel="Description">@context.Description</MudTd>
            <MudTd DataLabel="Created">@context.CreatedAt.ToString("MMM d, yyyy")</MudTd>
            <MudTd>
                <MudStack Row="true" Spacing="1">
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Href="@($"/csv-import/{context.Id}")">
                        Import CSV
                    </MudButton>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                   OnClick="() => DeleteAccount(context)" />
                </MudStack>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private List<AccountDto> _accounts = new();
    private bool _loading = true;
    private bool _showForm;
    private string _newName = "";
    private string _newDescription = "";
    private string? _message;
    private string? _error;

    protected override async Task OnInitializedAsync() => await LoadAccounts();

    private async Task LoadAccounts()
    {
        _loading = true;
        try { _accounts = await Http.GetFromJsonAsync<List<AccountDto>>("api/accounts") ?? new(); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private void ShowCreateForm() { _showForm = true; _newName = ""; _newDescription = ""; }
    private void CancelCreate() { _showForm = false; }

    private async Task CreateAccount()
    {
        if (string.IsNullOrWhiteSpace(_newName)) return;
        try
        {
            await Http.PostAsJsonAsync("api/accounts", new { Name = _newName, Description = _newDescription });
            _showForm = false;
            _message = "Account created.";
            await LoadAccounts();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task DeleteAccount(AccountDto account)
    {
        try
        {
            await Http.DeleteAsync($"api/accounts/{account.Id}");
            _message = $"Deleted {account.Name}.";
            await LoadAccounts();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private record AccountDto(Guid Id, string Name, string Description, DateTime CreatedAt);
}
