@page "/transactions"
@using System.Globalization
@using System.Net.Http.Json
@using Microsoft.AspNetCore.WebUtilities
@inject HttpClient Http
@inject NavigationManager Nav

<MudText Typo="Typo.h4" GutterBottom="true">Transactions</MudText>

@if (_error != null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="my-4">@_error</MudAlert>
}

<MudPaper Elevation="1" Class="mb-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="px-4 py-3">
        <MudSelect T="int" Label="Year" Value="_filterYear" ValueChanged="OnYearChangedInternal" Dense="true"
                   Margin="Margin.Dense" Style="width:90px; flex-shrink:0" Variant="Variant.Outlined">
            @foreach (var y in _availableYears)
            {
                <MudSelectItem Value="@y">@y</MudSelectItem>
            }
        </MudSelect>

        <MudTextField T="string" Value="_search" ValueChanged="OnSearchChanged" Immediate="true" Clearable="true"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Small"
                      Label="Search transactions..." Margin="Margin.Dense"
                      Variant="Variant.Outlined" Class="flex-grow-1 my-1" Style="min-width:180px" />

        <MudSelect T="string" Label="Account" Value="_accountSelection" ValueChanged="OnAccountSelectionChanged"
                   Dense="true" Margin="Margin.Dense" Style="width:190px; flex-shrink:0" Variant="Variant.Outlined">
            <MudSelectItem Value="@string.Empty">All accounts</MudSelectItem>
            @foreach (var account in _accounts)
            {
                <MudSelectItem Value="@account.Id.ToString()">@account.Name</MudSelectItem>
            }
        </MudSelect>

        <MudButtonGroup OverrideStyles="true">
            <MudButton OnClick="@(() => OnCategoryModeChanged(false))"
                       Variant="Variant.Outlined"
                       Color="@(!_useTrackedCategory ? Color.Primary : Color.Default)"
                       Size="Size.Small">Category</MudButton>
            <MudButton OnClick="@(() => OnCategoryModeChanged(true))"
                       Variant="Variant.Outlined"
                       Color="@(_useTrackedCategory ? Color.Primary : Color.Default)"
                       Size="Size.Small">Tracked</MudButton>
        </MudButtonGroup>

        <div style="position: relative;">
            <MudTooltip Text="@(_useTrackedCategory ? "Filter by tracked category" : "Filter by category")">
                <MudBadge Content="@(ActiveFilterCount > 0 ? ActiveFilterCount.ToString() : null)"
                          Color="Color.Primary" Overlap="true" Visible="@(ActiveFilterCount > 0)">
                    <MudIconButton Icon="@Icons.Material.Filled.FilterList"
                                   Color="@(ActiveFilterCount > 0 ? Color.Primary : Color.Default)"
                                   OnClick="ToggleCategoryFilter" id="cat-filter-btn" />
                </MudBadge>
            </MudTooltip>

            <MudPopover Open="_categoryPopoverOpen" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                <MudPaper Elevation="4" Style="width:260px; padding:12px">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">
                        @(_useTrackedCategory ? "Filter by Tracked Category" : "Filter by Category")
                    </MudText>

                    @if (ActiveFilterOptions.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">No categories available.</MudText>
                    }
                    else
                    {
                        <div style="max-height:260px; overflow-y:auto; margin-bottom:8px">
                            @foreach (var cat in ActiveFilterOptions)
                            {
                                var isCat = cat;
                                <MudCheckBox T="bool" Value="@_pendingFilterCategories.Contains(isCat)"
                                             ValueChanged="@(v => ToggleFilterCategorySelection(isCat, v))" Label="@isCat" Dense="true"
                                             Color="Color.Primary" />
                            }
                        </div>
                    }

                    <MudStack Row="true" Spacing="2">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="ApplyCategoryFilter">
                            Apply</MudButton>
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="ClearCategoryFilter">Clear</MudButton>
                    </MudStack>
                </MudPaper>
            </MudPopover>
        </div>
    </MudStack>
</MudPaper>

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-7" />
}
else if (_transactions.Count == 0)
{
    <MudText Color="Color.Secondary" Class="mt-4">No transactions found for this year/filter.</MudText>
}
else if (_visible.Count == 0)
{
    <MudText Color="Color.Secondary" Class="mt-4">
        @if (IsSearching)
        {
            @($"No transactions match '{_search}'.")
        }
        else
        {
            @("No transactions match the current filters.")
        }
    </MudText>
}
else if (IsSearching)
{
    <MudTable Items="@_visible" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="1" Dense="true" Class="mt-2">
        <HeaderContent>
            <MudTh>Date</MudTh>
            <MudTh>Name</MudTh>
            @if (_useTrackedCategory)
            {
                <MudTh>Tracked</MudTh>
            }
            else
            {
                <MudTh>Category</MudTh>
            }
            <MudTh Style="text-align:right">Amount</MudTh>
        </HeaderContent>
        <RowTemplate>
            @{
                var isCredit = context.Credit.HasValue;
                var displayAmount = isCredit ? context.Credit!.Value : (context.Debit ?? 0);
            }
            <MudTd DataLabel="Date">@context.Date.ToString("MMM d, yyyy")</MudTd>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            @if (_useTrackedCategory)
            {
                <MudTd DataLabel="Tracked">
                    <span class="eff-cat-cell" @onclick="() => OpenAssignDialog(context)" style="cursor:pointer">
                        @(string.IsNullOrEmpty(context.EffectiveCategoryName) ? "(uncategorized)" : context.EffectiveCategoryName)
                    </span>
                </MudTd>
            }
            else
            {
                <MudTd DataLabel="Category">
                    @(string.IsNullOrEmpty(context.Category) ? "(uncategorized)" : context.Category)
                </MudTd>
            }
            <MudTd DataLabel="Amount" Style="text-align:right">
                <MudText Color="@(isCredit ? Color.Success : Color.Error)" Style="font-weight:bold">
                    @displayAmount.ToString("C")
                </MudText>
            </MudTd>
        </RowTemplate>
    </MudTable>

    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">
        @_visible.Count match(es) for '@_search' in @_filterYear
    </MudText>
}
else
{
    <MudTable Items="@_visible" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="1" Dense="true" Class="mt-2"
              GroupBy="@(new TableGroupDefinition<TransactionDto>(t => t.Date.Month) { Expandable = true, IsInitiallyExpanded = true })">
        <HeaderContent>
            <MudTh>Date</MudTh>
            <MudTh>Name</MudTh>
            @if (ShowAccountColumn)
            {
                <MudTh>Account</MudTh>
            }
            @if (_useTrackedCategory)
            {
                <MudTh>Tracked</MudTh>
            }
            else
            {
                <MudTh>Category</MudTh>
            }
            <MudTh Style="text-align:right">Amount</MudTh>
        </HeaderContent>
        <GroupHeaderTemplate>
            @{
                var monthIndex = (int)context.Key!;
                var monthTxns = context.Items.ToList();
                var outflow = monthTxns.Sum(t => t.Debit ?? 0);
                var inflow = monthTxns.Sum(t => t.Credit ?? 0);
                var middleSpan = ShowAccountColumn ? 2 : 1;
            }
            <MudTd colspan="2">
                <strong>@CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(monthIndex)</strong>
            </MudTd>
            <MudTd colspan="@middleSpan" Style="color:var(--mud-palette-text-secondary)">
                @monthTxns.Count transaction(s)
            </MudTd>
            <MudTd Style="text-align:right; white-space:nowrap">
                <span style="color:var(--mud-palette-error); font-weight:bold">@outflow.ToString("C") out</span>
                <span style="margin-left:12px"></span>
                <span style="color:var(--mud-palette-success); font-weight:bold">@inflow.ToString("C") in</span>
            </MudTd>
        </GroupHeaderTemplate>
        <RowTemplate>
            @{
                var isCredit = context.Credit.HasValue;
                var displayAmount = isCredit ? context.Credit!.Value : (context.Debit ?? 0);
            }
            <MudTd DataLabel="Date">@context.Date.ToString("MMM d, yyyy")</MudTd>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            @if (ShowAccountColumn)
            {
                <MudTd DataLabel="Account">@context.AccountName</MudTd>
            }
            @if (_useTrackedCategory)
            {
                <MudTd DataLabel="Tracked">
                    <span class="eff-cat-cell" @onclick="() => OpenAssignDialog(context)" style="cursor:pointer">
                        @(string.IsNullOrEmpty(context.EffectiveCategoryName) ? "(uncategorized)" : context.EffectiveCategoryName)
                    </span>
                </MudTd>
            }
            else
            {
                <MudTd DataLabel="Category">
                    @(string.IsNullOrEmpty(context.Category) ? "(uncategorized)" : context.Category)
                </MudTd>
            }
            <MudTd DataLabel="Amount" Style="text-align:right">
                <MudText Color="@(isCredit ? Color.Success : Color.Error)" Style="font-weight:bold">
                    @displayAmount.ToString("C")
                </MudText>
            </MudTd>
        </RowTemplate>
    </MudTable>

    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">
        Showing @_visible.Count transaction(s) for @_filterYear
    </MudText>
}

<MudDialog @bind-Visible="_assignDialogVisible" Options="_assignDialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Assign Tracked Category</MudText>
    </TitleContent>
    <DialogContent>
        @if (_assignTarget != null)
        {
            <MudText Typo="Typo.body2" Class="mb-2"><strong>@_assignTarget.Name</strong></MudText>

            <MudSelect T="int?" Label="Category" @bind-Value="_assignCategoryId" Dense="true"
                       Margin="Margin.Dense" Variant="Variant.Outlined" Class="mb-2">
                <MudSelectItem T="int?" Value="@null">(none)</MudSelectItem>
                @foreach (var cat in _trackedCategoryDtos)
                {
                    <MudSelectItem T="int?" Value="@cat.Id">@cat.Name</MudSelectItem>
                }
            </MudSelect>

            <MudSwitch T="bool" @bind-Value="_assignCreateNew" Label="Create new category" Color="Color.Primary" Class="mb-2" />

            @if (_assignCreateNew)
            {
                <MudTextField T="string" @bind-Value="_assignNewCategoryName" Label="New category name"
                              Margin="Margin.Dense" Variant="Variant.Outlined" Class="mb-2" />
            }

            <MudTextField T="string" @bind-Value="_assignPattern" Label="Pattern (optional)"
                          HelperText="Leave blank to assign only this transaction"
                          Margin="Margin.Dense" Variant="Variant.Outlined" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _assignDialogVisible = false">Cancel</MudButton>
        @if (_assignCategoryId.HasValue || _assignCreateNew)
        {
            <MudButton OnClick="ClearTrackedCategory" Color="Color.Warning">Clear</MudButton>
        }
        <MudButton OnClick="SaveTrackedCategory" Color="Color.Primary">Save</MudButton>
    </DialogActions>
</MudDialog>

<style>
    .eff-cat-cell:hover { text-decoration: underline; color: var(--mud-palette-primary); }
</style>

@code {
    private List<TransactionDto> _transactions = new();
    private List<TransactionDto> _visible = new();
    private List<string> _categories = new();
    private List<string> _allCategories = new();
    private List<string> _trackedCategories = new();
    private List<CategoryDto> _trackedCategoryDtos = new();
    private List<int> _availableYears = new() { DateTime.Now.Year };
    private List<AccountDto> _accounts = new();
    private bool _loading = true;
    private string? _error;

    private int _filterYear = DateTime.Now.Year;
    private string? _filterAccountId;
    private string _accountSelection = "";
    private string _search = "";

    private bool _useTrackedCategory;
    private bool _categoryPopoverOpen;
    private HashSet<string> _selectedFilterCategories = new();
    private HashSet<string> _pendingFilterCategories = new();

    private bool _assignDialogVisible;
    private TransactionDto? _assignTarget;
    private int? _assignCategoryId;
    private bool _assignCreateNew;
    private string _assignNewCategoryName = "";
    private string _assignPattern = "";
    private DialogOptions _assignDialogOptions = new() { MaxWidth = MaxWidth.Small };

    private bool IsSearching => !string.IsNullOrWhiteSpace(_search);
    private bool ShowAccountColumn => string.IsNullOrEmpty(_filterAccountId);

    private List<string> ActiveFilterOptions => _useTrackedCategory ? _trackedCategories : _categories;
    private int ActiveFilterCount => _selectedFilterCategories.Count;

    protected override async Task OnInitializedAsync()
    {
        await LoadYears();
        await LoadCategories();
        await LoadTrackedCategories();
        await LoadAccounts();

        var uri = new Uri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("accountId", out var accountId))
        {
            _filterAccountId = accountId.ToString();
            _accountSelection = _filterAccountId;
        }

        await LoadTransactions();
    }

    private async Task LoadYears()
    {
        try
        {
            _availableYears = await Http.GetFromJsonAsync<List<int>>("api/settings/years") ?? _availableYears;
            if (_availableYears.Count > 0 && !_availableYears.Contains(_filterYear))
                _filterYear = _availableYears[0];
        }
        catch
        {
            _availableYears = Enumerable.Range(DateTime.Now.Year - 6, 7).OrderByDescending(y => y).ToList();
        }
    }

    private async Task LoadCategories()
    {
        try
        {
            _allCategories = await Http.GetFromJsonAsync<List<string>>("api/settings/categories") ?? new();
            _categories = new List<string>(_allCategories);
        }
        catch { }
    }

    private async Task LoadTrackedCategories()
    {
        try
        {
            _trackedCategoryDtos = await Http.GetFromJsonAsync<List<CategoryDto>>("api/categories") ?? new();
            _trackedCategories = _trackedCategoryDtos.Select(c => c.Name).ToList();
        }
        catch { }
    }

    private async Task LoadAccounts()
    {
        try { _accounts = await Http.GetFromJsonAsync<List<AccountDto>>("api/accounts") ?? new(); }
        catch { }
    }

    private void OnCategoryModeChanged(bool useTracked)
    {
        if (_useTrackedCategory == useTracked) return;
        _useTrackedCategory = useTracked;
        _selectedFilterCategories.Clear();
        _pendingFilterCategories.Clear();
        _categoryPopoverOpen = false;
        RecomputeVisible();
    }

    private async Task OnYearChangedInternal(int year)
    {
        _filterYear = year;
        _search = "";
        await LoadTransactions();
    }

    private void OnSearchChanged(string? value)
    {
        _search = value ?? "";
        RecomputeVisible();
    }

    private async Task OnAccountSelectionChanged(string accountId)
    {
        _accountSelection = accountId ?? "";
        _filterAccountId = string.IsNullOrEmpty(_accountSelection) ? null : _accountSelection;

        SyncAccountQuery();
        await LoadTransactions();
    }

    private void SyncAccountQuery()
    {
        var url = string.IsNullOrEmpty(_filterAccountId)
            ? "/transactions"
            : $"/transactions?accountId={Uri.EscapeDataString(_filterAccountId)}";
        Nav.NavigateTo(url, new NavigationOptions { ReplaceHistoryEntry = true });
    }

    private async Task LoadTransactions()
    {
        _loading = true;
        _error = null;
        try
        {
            var url = $"api/transactions?year={_filterYear}";
            if (!string.IsNullOrEmpty(_filterAccountId))
                url += $"&accountId={Uri.EscapeDataString(_filterAccountId)}";

            _transactions = await Http.GetFromJsonAsync<List<TransactionDto>>(url) ?? new();
            RecomputeVisible();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private void RecomputeVisible()
    {
        IEnumerable<TransactionDto> query = _transactions;

        if (_selectedFilterCategories.Count > 0)
        {
            if (_useTrackedCategory)
                query = query.Where(t => _selectedFilterCategories.Contains(t.EffectiveCategoryName));
            else
                query = query.Where(t => _selectedFilterCategories.Contains(t.Category));
        }

        if (IsSearching)
            query = query.Where(t => t.Name.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase));

        _visible = query.ToList();
    }

    private void ToggleCategoryFilter()
    {
        _pendingFilterCategories = new HashSet<string>(_selectedFilterCategories);
        _categoryPopoverOpen = !_categoryPopoverOpen;
    }

    private void ToggleFilterCategorySelection(string category, bool selected)
    {
        if (selected) _pendingFilterCategories.Add(category);
        else _pendingFilterCategories.Remove(category);
    }

    private void ApplyCategoryFilter()
    {
        _selectedFilterCategories = new HashSet<string>(_pendingFilterCategories);
        _categoryPopoverOpen = false;
        RecomputeVisible();
    }

    private void ClearCategoryFilter()
    {
        _selectedFilterCategories.Clear();
        _pendingFilterCategories.Clear();
        _categoryPopoverOpen = false;
        RecomputeVisible();
    }

    private void OpenAssignDialog(TransactionDto txn)
    {
        _assignTarget = txn;
        _assignCategoryId = txn.EffectiveCategoryId;
        _assignCreateNew = false;
        _assignNewCategoryName = "";
        _assignPattern = "";
        _assignDialogVisible = true;
    }

    private async Task SaveTrackedCategory()
    {
        if (_assignTarget == null) return;

        int? categoryId = _assignCategoryId;
        int? ruleId = null;

        if (_assignCreateNew && !string.IsNullOrWhiteSpace(_assignNewCategoryName))
        {
            var result = await Http.PostAsJsonAsync("api/categories", new { Name = _assignNewCategoryName.Trim() });
            var created = await result.Content.ReadFromJsonAsync<CategoryDto>();
            if (created != null) categoryId = created.Id;
        }

        if (!string.IsNullOrWhiteSpace(_assignPattern) && categoryId.HasValue)
        {
            var result = await Http.PostAsJsonAsync("api/category-rules", new { Pattern = _assignPattern.Trim(), CategoryId = categoryId.Value });
            var created = await result.Content.ReadFromJsonAsync<RuleDto>();
            if (created != null) ruleId = created.Id;
        }

        await Http.PatchAsJsonAsync(
            $"api/transactions/{_assignTarget.TransactionId}/effective-category",
            new { CategoryId = categoryId, CategoryRuleId = ruleId });

        _assignDialogVisible = false;
        await LoadTrackedCategories();
        await LoadTransactions();
        RecomputeVisible();
    }

    private async Task ClearTrackedCategory()
    {
        if (_assignTarget == null) return;

        await Http.PatchAsJsonAsync(
            $"api/transactions/{_assignTarget.TransactionId}/effective-category",
            new { CategoryId = (int?)null, CategoryRuleId = (int?)null });

        _assignDialogVisible = false;
        await LoadTransactions();
        RecomputeVisible();
    }

    private record TransactionDto(
        string TransactionId, string AccountId, string AccountName, DateOnly Date,
        string Name, decimal? Credit, decimal? Debit, decimal Amount, string Category,
        int? EffectiveCategoryId, string EffectiveCategoryName, bool IsManualAssignment);

    private record AccountDto(Guid Id, string Name, string Description, DateTime CreatedAt);
    private record CategoryDto(int Id, string Name);
    private record RuleDto(int Id, string Pattern, string CategoryName, int CategoryId, int MatchCount);
}
