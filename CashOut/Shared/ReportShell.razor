@using MudBlazor

<MudText Typo="Typo.h4" GutterBottom="true">@Title</MudText>

<MudPaper Elevation="1" Class="pa-4 mb-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="4">
        @if (ShowMonthPicker)
        {
            <MudSelect T="int" Label="Year" Value="Year" ValueChanged="OnYearChanged" Dense="true"
                       Margin="Margin.Dense" Style="width:100px" Variant="Variant.Outlined">
                @foreach (var y in AvailableYears)
                {
                    <MudSelectItem Value="@y">@y</MudSelectItem>
                }
            </MudSelect>

            <MudSelect T="int?" Label="Month" Value="Month" ValueChanged="OnMonthChanged" Dense="true"
                       Clearable="true" Margin="Margin.Dense" Style="width:140px" Variant="Variant.Outlined">
                <MudSelectItem T="int?" Value="@null">All months</MudSelectItem>
                @for (int m = 1; m <= 12; m++)
                {
                    var month = m;
                    <MudSelectItem T="int?" Value="@month">@MonthName(month)</MudSelectItem>
                }
            </MudSelect>
        }

        @if (ShowMonthRange)
        {
            <MudSelect T="int?" Label="From Month" Value="FromMonth" ValueChanged="OnFromMonthChanged"
                       Dense="true" Margin="Margin.Dense"
                       Style="width:130px" Variant="Variant.Outlined">
                @for (int m = 1; m <= 12; m++)
                {
                    var month = m;
                    <MudSelectItem T="int?" Value="@month">@MonthName(month)</MudSelectItem>
                }
            </MudSelect>

            <MudSelect T="int?" Label="From Year" Value="FromYear" ValueChanged="OnFromYearChanged"
                       Dense="true" Margin="Margin.Dense" Style="width:100px" Variant="Variant.Outlined">
                @foreach (var yr in RangeYears)
                {
                    var y = yr;
                    <MudSelectItem T="int?" Value="@((int?)y)">@y</MudSelectItem>
                }
            </MudSelect>

            <MudSelect T="int?" Label="To Month" Value="ToMonth" ValueChanged="OnToMonthChanged"
                       Dense="true" Margin="Margin.Dense"
                       Style="width:130px" Variant="Variant.Outlined">
                @for (int m = 1; m <= 12; m++)
                {
                    var month = m;
                    <MudSelectItem T="int?" Value="@month">@MonthName(month)</MudSelectItem>
                }
            </MudSelect>

            <MudSelect T="int?" Label="To Year" Value="ToYear" ValueChanged="OnToYearChanged"
                       Dense="true" Margin="Margin.Dense" Style="width:100px" Variant="Variant.Outlined">
                @foreach (var yr in RangeYears)
                {
                    var y = yr;
                    <MudSelectItem T="int?" Value="@((int?)y)">@y</MudSelectItem>
                }
            </MudSelect>
        }

        @if (Accounts is { Count: > 0 })
        {
            <MudSelect T="string" Label="Account"
                       Value="@(AccountId ?? "")"
                       ValueChanged="v => OnAccountIdChanged.InvokeAsync(string.IsNullOrEmpty(v) ? null : v)"
                       Text="@(string.IsNullOrEmpty(AccountId) ? "All Accounts" : Accounts.FirstOrDefault(a => a.Id == AccountId)?.Name ?? "All Accounts")"
                       Dense="true" Margin="Margin.Dense" Style="width:220px" Variant="Variant.Outlined">
                <MudSelectItem T="string" Value="@("")">All Accounts</MudSelectItem>
                @foreach (var acct in Accounts)
                {
                    <MudSelectItem T="string" Value="@acct.Id">@acct.Name</MudSelectItem>
                }
            </MudSelect>
        }

        <MudSpacer />

        @if (!string.IsNullOrEmpty(ExportHref))
        {
            <MudButton Href="@ExportHref" Target="_blank"
                       Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download">
                Export CSV
            </MudButton>
        }
    </MudStack>
</MudPaper>

@if (Loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-7" />
}
else if (!string.IsNullOrEmpty(Error))
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="my-4">@Error</MudAlert>
}
else
{
    @ChildContent
}

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public int Year { get; set; } = DateTime.Now.Year;
    [Parameter] public List<int> AvailableYears { get; set; } = new();
    [Parameter] public EventCallback<int> OnYearChanged { get; set; }
    [Parameter] public List<int> RangeYears { get; set; } = new();
    [Parameter] public int? Month { get; set; }
    [Parameter] public EventCallback<int?> OnMonthChanged { get; set; }
    [Parameter] public bool ShowMonthPicker { get; set; }
    [Parameter] public bool ShowMonthRange { get; set; }
    [Parameter] public int? FromMonth { get; set; }
    [Parameter] public EventCallback<int?> OnFromMonthChanged { get; set; }
    [Parameter] public int? FromYear { get; set; }
    [Parameter] public EventCallback<int?> OnFromYearChanged { get; set; }
    [Parameter] public int? ToMonth { get; set; }
    [Parameter] public EventCallback<int?> OnToMonthChanged { get; set; }
    [Parameter] public int? ToYear { get; set; }
    [Parameter] public EventCallback<int?> OnToYearChanged { get; set; }
    [Parameter] public List<AccountOption>? Accounts { get; set; }
    [Parameter] public string? AccountId { get; set; }
    [Parameter] public EventCallback<string?> OnAccountIdChanged { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public string? ExportHref { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private static string MonthName(int m) =>
        System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedMonthName(m);

    public record AccountOption(string Id, string Name);
}
